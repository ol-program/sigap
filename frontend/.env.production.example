# Salin jadi frontend/.env.production di VPS (TIDAK di-commit, lihat root
# .gitignore) -- Vite otomatis pakai file ini saat `npm run build`
# (mode "production" default). Isi dengan domain API produksi asli, BUKAN
# localhost -- lihat deploy/nginx/api.conf.
VITE_API_BASE_URL=https://REPLACE_WITH_API_DOMAIN
