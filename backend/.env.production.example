# Template untuk backend/.env.production -- salin jadi .env.production lalu
# isi nilai asli. File .env.production TIDAK di-commit (lihat root .gitignore),
# ini (.example) yang di-commit sebagai dokumentasi field yang dibutuhkan.

# WAJIB -- generate baru per deployment, jangan reuse:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Domain/IP frontend asli di produksi, dipisah koma kalau >1 origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# anthropic (default) atau gemini
AI_PROVIDER=anthropic

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opsional -- hanya kalau AI_PROVIDER=gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional -- fallback chain model dipisah koma, lihat README.
# CLAUDE_MODEL=
# GEMINI_MODEL=
